/// The same library, driven by a .ft XML template.
///
/// Run from the project root so the relative template path resolves.

val formant = use("../src/formant/formant.sx")
val stdio   = use("std/stdio")
val str     = use("std/string")

fn on_event(ev: formant.Event, _: ref void) void = trust {
    if str.eql_cstr(ev.kind, c"submit") {
        val display_name: str.StringView = formant.value(ev.values, "display_name")
        val email: str.StringView = formant.value(ev.values, "email")
        if display_name.len == 0 {
            formant.set_error(ev.form, "display_name", "A display name is required.")
            formant.focus(ev.form, "display_name")
            return
        }
        if !str.contains(email, "@") {
            formant.set_error(ev.form, "email", "Enter a valid email address.")
            formant.focus(ev.form, "email")
            return
        }
        formant.clear_errors(ev.form)
        formant.open_dialog(ev.form, "saved")
        return
    }

    if str.eql_cstr(ev.kind, c"click") {
        if str.eql_cstr(ev.name, c"close-saved") {
            formant.close_dialog(ev.form, "saved")
        } elif str.eql_cstr(ev.name, c"help") {
            formant.toast(ev.form, "Click a field to edit it. Changes are local to this demo.", "info")
        } elif str.eql_cstr(ev.name, c"cancel") {
            formant.set_value(ev.form, "display_name", "")
            formant.set_value(ev.form, "username", "")
            formant.toast(ev.form, "Changes discarded.", "info")
        }
    }
}

pub fn main() i32 = trust {
    match formant.new_from_ft("examples/profile_form.ft", 0, 0) {
        err e => {
            stdio.print(
                "formant: template error at line {d}: {s}\n",
                {e.line, e.message}
            )
            return 1
        }
        ok f => {
            formant.on_submit(f, on_event, none)
            formant.on_action(f, "help", on_event, none)
            formant.on_action(f, "cancel", on_event, none)
            formant.on_action(f, "close-saved", on_event, none)
            val code: i32 = formant.run(f)
            formant.free(f)
            return code
        }
    }
}
