val formant = use("./formant/formant.sx")
val stdio   = use("std/stdio")
val str     = use("std/string")

fn handle_event(ev: formant.Event, _: ref void) void = trust {
    if str.eql_cstr(ev.kind, c"submit") {
        val email: str.StringView = formant.value(ev.values, "email")
        val message: str.StringView = formant.value(ev.values, "message")
        if email.len == 0 {
            formant.set_error(ev.form, "email", "Enter an email address.")
            formant.focus(ev.form, "email")
            formant.toast(ev.form, "A couple of fields still need attention.", "error")
            return
        }
        if !str.contains(email, "@") {
            formant.set_error(ev.form, "email", "That does not look like an email address.")
            formant.focus(ev.form, "email")
            return
        }
        if message.len < 10 {
            formant.set_error(ev.form, "message", "Tell us a little more (at least 10 characters).")
            formant.focus(ev.form, "message")
            return
        }
        formant.clear_errors(ev.form)
        formant.toast(ev.form, "Message sent. We will get back to you soon.", "success")
        return
    }

    if str.eql_cstr(ev.kind, c"click") {
        if str.eql_cstr(ev.name, c"about") {
            formant.open_dialog(ev.form, "about")
        } elif str.eql_cstr(ev.name, c"close-about") {
            formant.close_dialog(ev.form, "about")
        } elif str.eql_cstr(ev.name, c"cancel") {
            formant.open_dialog(ev.form, "confirm")
        } elif str.eql_cstr(ev.name, c"confirm-discard") {
            formant.close_dialog(ev.form, "confirm")
            formant.clear_errors(ev.form)
            formant.set_value(ev.form, "first", "")
            formant.set_value(ev.form, "last", "")
            formant.set_value(ev.form, "email", "")
            formant.set_value(ev.form, "message", "")
            formant.set_checked(ev.form, "updates", false)
            formant.toast(ev.form, "Draft discarded.", "info")
        } elif str.eql_cstr(ev.name, c"keep-editing") {
            formant.close_dialog(ev.form, "confirm")
        } elif str.eql_cstr(ev.name, c"shortcut") {
            formant.set_value(ev.form, "first", "Ada")
            formant.set_value(ev.form, "last", "Lovelace")
            formant.set_value(ev.form, "email", "ada@example.com")
            formant.set_value(
                ev.form,
                "message",
                "I would like to talk about analytical engines."
            )
            formant.toast(ev.form, "Filled in a sample message.", "info")
        }
    }
}

pub fn main() i32 = trust {
    match formant.new_form("Formant | Contact", 900, 840) {
        err e => {
            stdio.print("could not create form: {s}\n", {e.message})
            return 1
        }
        ok f => {
            formant.header(f, "Contact us", "A native-looking form, rendered by a webview")
            formant.button(f, "shortcut", "Fill sample", 3)
            formant.button(f, "about", "About", 3)
            formant.end(f)

            formant.section(f, "Your details", "We only use this to reply to your message.")
            formant.row(f)
            formant.text_input(f, "first", "First name")
            formant.required(f)
            formant.placeholder(f, "Ada")
            formant.text_input(f, "last", "Last name")
            formant.placeholder(f, "Lovelace")
            formant.end(f)
            formant.email_input(f, "email", "Email")
            formant.required(f)
            formant.placeholder(f, "ada@example.com")
            formant.help(f, "We reply from hello@example.com.")
            formant.select(
                f,
                "topic",
                "What is this about?",
                "product:Product question|support:Technical support|billing:Billing|press:Press"
            )
            formant.textarea(f, "message", "Message", 6)
            formant.required(f)
            formant.placeholder(f, "How can we help?")
            formant.help(f, "At least 10 characters.")
            formant.checkbox(f, "updates", "Send me occasional product updates")
            formant.end(f)

            formant.section(f, "Preferences", "These choices only affect this session.")
            formant.row(f)
            formant.range(f, "priority", "Priority", 1, 5, 3)
            formant.end(f)
            formant.text(
                f,
                "This demo uses the same retained tree whether it is built by calls or loaded from a .ft template."
            )
            formant.end(f)

            formant.actions(f)
            formant.button(f, "cancel", "Discard", 3)
            formant.submit_button(f, "send", "Send message")
            formant.end(f)

            formant.dialog(f, "about", "About Formant")
            formant.text(
                f,
                "Formant is a small Spectre UI library. It renders HTML and CSS through webview and emulates the host platform's design language: Adwaita on Linux, Aqua on macOS, and Fluent on Windows."
            )
            formant.actions(f)
            formant.button(f, "close-about", "Close", 1)
            formant.end(f)
            formant.end(f)

            formant.dialog(f, "confirm", "Discard this draft?")
            formant.text(f, "The fields you have filled in will be cleared.")
            formant.actions(f)
            formant.button(f, "keep-editing", "Keep editing", 3)
            formant.button(f, "confirm-discard", "Discard", 2)
            formant.end(f)
            formant.end(f)

            formant.on_submit(f, handle_event, none)
            formant.on_action(f, "about", handle_event, none)
            formant.on_action(f, "close-about", handle_event, none)
            formant.on_action(f, "cancel", handle_event, none)
            formant.on_action(f, "confirm-discard", handle_event, none)
            formant.on_action(f, "keep-editing", handle_event, none)
            formant.on_action(f, "shortcut", handle_event, none)

            val code: i32 = formant.run(f)
            formant.free(f)
            return code
        }
    }
}
