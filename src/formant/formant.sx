    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView
) void = trust {
    val n = field_base(f, node.FieldKind.Password, field_name, label)
    if n != none {
        f.last_field = n
    }
}

pub fn number_input(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView
) void = trust {
    val n = field_base(f, node.FieldKind.Number, field_name, label)
    if n != none {
        f.last_field = n
    }
}

pub fn textarea(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView,
    rows: i32
) void = trust {
    val n = field_base(f, node.FieldKind.Textarea, field_name, label)
    if n != none {
        val mn: mut ref node.Node = n as mut ref node.Node
        val buf: mut [32]u8 = @zeroed
        @snprintf(@addr(buf) as ref u8, 32, "{d}", {rows as i64})
        mn.rows = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
        f.last_field = n
    }
}

pub fn select(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView,
    options: str.StringView
) void = trust {
    val n = field_base(f, node.FieldKind.Select, field_name, label)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    add_option_spec(f.arena, mn, options, false)
    f.last_field = n
}

pub fn radio(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView,
    options: str.StringView
) void = trust {
    val n = field_base(f, node.FieldKind.Radio, field_name, label)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    add_option_spec(f.arena, mn, options, false)
    f.last_field = n
}

pub fn checkbox(f: mut ref Form, field_name: str.StringView, label: str.StringView) void = trust {
    val n = field_base(f, node.FieldKind.Checkbox, field_name, label)
    if n != none {
        f.last_field = n
    }
}

pub fn range(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView,
    min_value: i32,
    max_value: i32,
    value: i32
) void = trust {
    val n = field_base(f, node.FieldKind.Range, field_name, label)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    val buf: mut [64]u8 = @zeroed
    @snprintf(@addr(buf) as ref u8, 64, "{d}", {min_value as i64})
    mn.min = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
    @snprintf(@addr(buf) as ref u8, 64, "{d}", {max_value as i64})
    mn.max = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
    @snprintf(@addr(buf) as ref u8, 64, "{d}", {value as i64})
    mn.value = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
    f.last_field = n
}

pub fn add_option(f: mut ref Form, value: str.StringView, label: str.StringView) void = trust {
    if f.last_field == none {
        return
    }
    val n: mut ref node.Node = f.last_field as mut ref node.Node
    node.option_add(f.arena, n, value, label)
    f.last_node = f.last_field
}

fn add_option_spec(
    b: ref mem.Bump,
    n: mut ref node.Node,
    options: str.StringView,
    as_columns: bool
) void = trust {
    if options.len <= 0 {
        return
    }
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        val at_end: bool = i >= options.len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(options.ptr, i)) as u8
        }
        if at_end || c == 124 || c == 59 {
            if i > start {
                val item: str.StringView = str.slice(options, start, i)
                val colon = str.find(item, ":")
                if colon is some at {
                    if as_columns {
                        node.column_add(
                            b,
                            n,
                            str.slice(item, 0, at),
                            str.slice(item, at + 1, item.len)
                        )
                    } else {
                        node.option_add(
                            b,
                            n,
                            str.slice(item, 0, at),
                            str.slice(item, at + 1, item.len)
                        )
                    }
                } else {
                    if as_columns {
                        node.column_add(b, n, item, item)
                    } else {
                        node.option_add(b, n, item, item)
                    }
                }
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i++
    }
}

pub fn button(
    f: mut ref Form,
    action_name: str.StringView,
    label: str.StringView,
    style: i32
) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Button)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.name = arena_str(f.arena, action_name)
    mn.label = arena_str(f.arena, label)
    if style == 1 {
        mn.variant = node.Variant.Primary
    } elif style == 2 {
        mn.variant = node.Variant.Danger
    } elif style == 3 {
        mn.variant = node.Variant.Ghost
    } elif style == 4 {
        mn.variant = node.Variant.Link
    }
    add(f, n)
}

pub fn submit_button(
    f: mut ref Form,
    action_name: str.StringView,
    label: str.StringView
) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Button)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.name = arena_str(f.arena, action_name)
    mn.label = arena_str(f.arena, label)
    mn.variant = node.Variant.Primary
    mn.submit = true
    add(f, n)
}

