fn add_handler(
    f: ref Form,
    event: str.StringView,
    action_name: str.StringView,
    handler: fn(Event, ref void) void,
    user: ref void
) void = trust {
    if handler == none {
        return
    }
    val mf: mut ref Form = f as mut ref Form
    val h: mut ref Handler = @alloc(@sizeof(Handler) as usize) as mut ref Handler
    if h == none {
        return
    }
    @memset(h as ref void, 0, @sizeof(Handler) as usize)
    h.event = heap_str(event)
    h.name = heap_str(action_name)
    h.fnaddr = handler as usize
    h.user = user
    h.next = mf.handlers
    mf.handlers = h
}

pub fn on_event(
    f: ref Form,
    event: str.StringView,
    handler: fn(Event, ref void) void,
    user: ref void
) void = trust {
    add_handler(f, event, "", handler, user)
}

pub fn on_action(
    f: ref Form,
    action_name: str.StringView,
    handler: fn(Event, ref void) void,
    user: ref void
) void = trust {
    add_handler(f, "click", action_name, handler, user)
}

pub fn on_submit(f: ref Form, handler: fn(Event, ref void) void, user: ref void) void = trust {
    add_handler(f, "submit", "", handler, user)
}

fn handler_matches(h: ref Handler, ev: Event) bool = trust {
    if h.event != none && @load8(h.event) != 0 {
        if !str.eql_cstr(ev.kind, h.event) {
            return false
        }
    }
    if h.name != none && @load8(h.name) != 0 {
        if !str.eql_cstr(ev.name, h.name) {
            return false
        }
    }
    return true
}

fn dispatch(f: ref Form, ev: Event) void = trust {
    val cur: mut ref Handler = f.handlers
    for {
        if cur == none {
            break
        }
        val h: ref Handler = cur as ref Handler
        if handler_matches(h, ev) {
            val callback: fn(Event, ref void) void = @bitcast(
                h.fnaddr,
                fn(Event, ref void) void
            )
            callback(ev, h.user)
        }
        cur = h.next
    }
}

fn on_binding(id: ref u8, req: ref u8, arg: ref void) void = trust {
    val f: mut ref Form = arg as ref Form
    if f == none {
        return
    }
    if f.wv != none {
        webview.webview_return(f.wv, id, 0, c"null")
    }
    if req == none {
        return
    }
    val parsed = json.parse(str.from_cstr(req))
    match parsed {
        err _ => {}
        ok doc => {
            val root = json.root(doc)
            val payload = json.array_get(root, 0)
            match payload {
                none => {}
                some p => {
                    val kind_opt = json.object_get_str(p, "type")
                    val name_opt = json.object_get_str(p, "name")
                    val values_opt = json.object_get(p, "values")
                    val kind: mut str.StringView = empty()
                    val action: mut str.StringView = empty()
                    if kind_opt is some k {
                        kind = k
                    }
                    if name_opt is some n {
                        action = n
                    }
                    val valid_values: mut bool = false
                    if values_opt is some _ {
                        valid_values = true
                    }
                    val ev: Event = Event{
                        kind: kind
                        name: action
                        values: Values{doc: doc, valid: valid_values}
                        form: f
                    }
                    dispatch(f, ev)
                }
            }
            json.doc_free(doc)
        }
    }
}

fn on_window_binding(id: ref u8, req: ref u8, arg: ref void) void = trust {
    val f: mut ref Form = arg as ref Form
    val maximized: mut bool = false
    if f != none && f.wv != none && req != none {
        val parsed = json.parse(str.from_cstr(req))
        match parsed {
            err _ => {}
            ok doc => {
                val root = json.root(doc)
                val payload = json.array_get(root, 0)
                match payload {
                    none => {}
                    some p => {
                        val action_opt = json.object_get_str(p, "action")
                        val action: mut str.StringView = empty()
                        if action_opt is some value {
                            action = value
                        }
                        val native: mut ref void = webview.get_window(f.wv)
                        if native != none {
                            if str.eql_cstr(action, c"minimize") {
                                win.minimize(native)
                            } elif str.eql_cstr(action, c"close") {
                                win.close_window(native)
                            } elif str.eql_cstr(action, c"move") {
                                win.begin_move(native)
                            } elif str.eql_cstr(action, c"resize") {
                                val edge: mut i32 = 0
                                if json.object_get_int(p, "arg") is some value {
                                    edge = value as i32
                                }
                                win.begin_resize(native, edge)
                            } elif str.eql_cstr(action, c"toggle-maximize") {
                                win.toggle_maximize(native)
                                maximized = win.is_maximized(native) != 0
                            } elif str.eql_cstr(action, c"state") {
                                maximized = win.is_maximized(native) != 0
                            } elif str.eql_cstr(action, c"titlebar-height") {
                                val height: mut i32 = 0
                                if json.object_get_int(p, "arg") is some value {
                                    height = value as i32
                                }
                                win.set_titlebar_height(native, height)
                            }
                        }
                    }
                }
                json.doc_free(doc)
            }
        }
    }
    if f != none && f.wv != none {
        if maximized {
            webview.webview_return(f.wv, id, 0, c"true")
        } else {
            webview.webview_return(f.wv, id, 0, c"false")
        }
    }
}

pub fn value(v: Values, field_name: str.StringView) str.StringView = trust {
    if !v.valid {
        return empty()
    }
    val root = json.root(v.doc)
    val values_obj = json.object_get(root, "values")
    match values_obj {
        none => {
            return empty()
        }
        some obj => {
            val found = json.object_get_str(obj, field_name)
            match found {
                some s => {
                    return s
                }
                none => {
                    return empty()
                }
            }
        }
    }
}

pub fn has_value(v: Values, field_name: str.StringView) bool = trust {
    if !v.valid {
        return false
    }
    val root = json.root(v.doc)
    val values_obj = json.object_get(root, "values")
    match values_obj {
        none => {
            return false
        }
        some obj => {
            match json.object_get(obj, field_name) {
                some _ => {
                    return true
                }
                none => {
                    return false
                }
            }
        }
    }
}

pub fn checked_value(v: Values, field_name: str.StringView) bool = trust {
    if !v.valid {
        return false
    }
    val root = json.root(v.doc)
    val values_obj = json.object_get(root, "values")
    match values_obj {
        none => {
            return false
        }
        some obj => {
            val found = json.object_get_bool(obj, field_name)
            match found {
                some b => {
                    return b
                }
                none => {
                    return false
                }
            }
        }
    }
}

pub fn int_value(v: Values, field_name: str.StringView) i64 = trust {
    if !v.valid {
        return 0
    }
    val root = json.root(v.doc)
    val values_obj = json.object_get(root, "values")
    match values_obj {
        none => {
            return 0
        }
        some obj => {
            val found = json.object_get_int(obj, field_name)
            match found {
                some n => {
                    return n
                }
                none => {
                    return 0
                }
            }
        }
    }
}

pub fn float_value(v: Values, field_name: str.StringView) f64 = trust {
    if !v.valid {
        return 0.0
    }
    val root = json.root(v.doc)
    val values_obj = json.object_get(root, "values")
    match values_obj {
        none => {
            return 0.0
        }
        some obj => {
            val found = json.object_get_float(obj, field_name)
            match found {
                some n => {
                    return n
                }
                none => {
                    return 0.0
                }
            }
        }
    }
}

fn eval_buffer(f: ref Form, sb: builder.StringBuilder) void = trust {
    if f.wv == none {
        return
    }
    webview.eval(f.wv, sb.ptr)
}

fn begin_call(sb: builder.StringBuilder, name: ref u8) void = trust {
    builder.StringBuilder.append_cstr(sb, name)
    builder.StringBuilder.append_cstr(sb, c"(")
}

fn finish_call(sb: builder.StringBuilder) void = trust {
    builder.StringBuilder.append_cstr(sb, c")")
}

pub fn set_value(f: ref Form, field_name: str.StringView, new_value: str.StringView) void = trust {
    val sb = builder.StringBuilder.new()
    begin_call(sb, c"formant.setValue")
    html_mod.js_quote_into(sb, field_name)
    builder.StringBuilder.append_cstr(sb, c",")
    html_mod.js_quote_into(sb, new_value)
    finish_call(sb)
    eval_buffer(f, sb)
    builder.StringBuilder.free(sb)
}

pub fn set_checked(f: ref Form, field_name: str.StringView, state: bool) void = trust {
    val sb = builder.StringBuilder.new()
    begin_call(sb, c"formant.setChecked")
    html_mod.js_quote_into(sb, field_name)
    builder.StringBuilder.append_cstr(sb, c",")
    if state {
        builder.StringBuilder.append_cstr(sb, c"true")
    } else {
        builder.StringBuilder.append_cstr(sb, c"false")
    }
    finish_call(sb)
    eval_buffer(f, sb)
    builder.StringBuilder.free(sb)
}

