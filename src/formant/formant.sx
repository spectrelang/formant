    builder.StringBuilder.append_cstr(sb, c",")
    html_mod.put_int(sb, amount as i64)
    finish_call(sb)
    eval_buffer(f, sb)
    builder.StringBuilder.free(sb)
}

pub fn eval(f: ref Form, code: str.StringView) void = trust {
    val sb = builder.StringBuilder.new()
    builder.StringBuilder.append(sb, code)
    eval_buffer(f, sb)
    builder.StringBuilder.free(sb)
}

pub fn quit(f: ref Form) void = trust {
    if f.wv != none {
        webview.terminate(f.wv)
    }
}

pub fn run(f: mut ref Form) i32 = trust {
    return run_with(f, false)
}

pub fn run_with(f: mut ref Form, debug: bool) i32 = trust {
    if f.root == none {
        stdio.eputs("formant: no form to run")
        return 1
    }
    val debug_flag: mut i32 = 0
    if debug {
        debug_flag = 1
    }
    f.debug = debug
    f.wv = webview.create(debug_flag, none)
    if f.wv == none {
        stdio.eputs("formant: could not create the webview window")
        return 1
    }

    webview.set_title(f.wv, f.title)

    val native: mut ref void = webview.get_window(f.wv)
    val custom: mut bool = false
    if f.decorations == Decorations.Custom as i32 && native != none {
        if win.supports_custom(native) != 0 {
            win.set_decorated(native, 0)
            custom = true
        }
    }

    webview.set_size(f.wv, f.width, f.height, webview.HINT_NONE)

    webview.bind(f.wv, c"formant_event", on_binding, f as ref void)
    webview.bind(f.wv, c"formant_window", on_window_binding, f as ref void)

    val doc = html_mod.render(f.root, f.title, f.theme, custom)
    webview.set_html(f.wv, doc.ptr)
    builder.StringBuilder.free(doc)

    if native != none {
        win.show_when_loaded(native)
    }

    val code: i32 = webview.run(f.wv)
    webview.destroy(f.wv)
    f.wv = none
    return code
}
