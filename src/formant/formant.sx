pub fn progress(f: mut ref Form, label: str.StringView, value: i32, max_value: i32) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Progress)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.label = arena_str(f.arena, label)
    val buf: mut [64]u8 = @zeroed
    @snprintf(@addr(buf) as ref u8, 64, "{d}", {value as i64})
    mn.value = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
    @snprintf(@addr(buf) as ref u8, 64, "{d}", {max_value as i64})
    mn.max = arena_str(f.arena, str.from_cstr(@addr(buf) as ref u8))
    add(f, n)
}

pub fn table(f: mut ref Form, columns: str.StringView) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Table)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    add_option_spec(f.arena, mn, columns, true)
    add(f, n)
    f.cursor = n
    f.table = n
}

pub fn table_row(f: mut ref Form, cells: str.StringView) void = trust {
    if f.table == none {
        return
    }
    val row_node: ref node.Node = node.new(f.arena, node.Kind.TableRow)
    if row_node == none {
        return
    }
    val mr: mut ref node.Node = row_node as mut ref node.Node
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        val at_end: bool = i >= cells.len
        val c: mut u8 = 0
        if !at_end {
            c = @load8(@ptradd(cells.ptr, i)) as u8
        }
        if at_end || c == 124 {
            val cell: ref node.Node = node.new(f.arena, node.Kind.Cell)
            if cell != none {
                val mc: mut ref node.Node = cell as mut ref node.Node
                val item: str.StringView = str.trim(str.slice(cells, start, i))
                mc.text = arena_str(f.arena, item)
                node.append(mr, cell)
            }
            start = i + 1
        }
        if at_end {
            break
        }
        i++
    }
    node.append(f.table as mut ref node.Node, row_node)
}

