/// Formant: a small cross-platform form UI library.
///
/// Forms can be assembled with ordinary function calls or loaded from a .ft
/// XML template. Both produce the same retained node tree, which is rendered
/// once into a webview document and styled with the host platform's design
/// language.

val mem      = use("mem.sx")
val builder  = use("std/string/builder")
val fs       = use("std/fs")
val ft_mod   = use("ft.sx")
val html_mod = use("html.sx")
val json     = use("std/json")
val node     = use("node.sx")
val stdio    = use("std/stdio")
val str      = use("std/string")
val webview  = use("webview.sx")
val win      = use("win.sx")

pub enum Theme = {
    Auto
    Linux
    Darwin
    Windows
}

pub enum Decorations = {
    System
    Custom
}

pub enum UiErrorKind = {
    OutOfMemory
    Io
    Template
}

pub type UiError = {
    kind: UiErrorKind
    line: i32
    message: str.StringView
}

pub type Values = {
    doc: json.JsonDoc
    valid: bool
}

pub type Event = {
    kind: str.StringView
    name: str.StringView
    values: Values
    form: ref Form
}

type Handler = {
    event: mut ref u8
    name: mut ref u8
    fnaddr: mut usize
    user: mut ref void
    next: mut ref Handler
}

pub type Form = {
    wv: mut ref void
    arena: mut ref mem.Bump
    root: mut ref node.Node
    cursor: mut ref node.Node
    last_node: mut ref node.Node
    last_field: mut ref node.Node
    table: mut ref node.Node
    handlers: mut ref Handler
    title: mut ref u8
    name: mut ref u8
    width: mut i32
    height: mut i32
    theme: mut i32
    decorations: mut i32
    debug: mut bool
}

fn empty() str.StringView = {
    return str.view(c"", 0)
}

fn arena_str(b: ref mem.Bump, s: str.StringView) ref u8 = trust {
    return node.strdup(b, s)
}

fn heap_str(s: str.StringView) ref u8 = trust {
    if s.len <= 0 {
        return c""
    }
    val out: ref u8 = @alloc((s.len + 1) as usize) as ref u8
    if out == none {
        return c""
    }
    @memcpy(out as ref void, s.ptr as ref void, s.len as usize)
    @store8(@ptradd(out, s.len), 0)
    return out
}

fn alloc_form() mut ref Form = trust {
    val raw: ref void = @alloc(@sizeof(Form) as usize)
    if raw == none {
        return none
    }
    val f: mut ref Form = raw as mut ref Form
    @memset(f as ref void, 0, @sizeof(Form) as usize)
    f.wv = none
    f.handlers = none
    f.title = c""
    f.name = c""
    f.theme = 0
    f.decorations = 0
    f.debug = false
    return f as mut ref Form
}

fn oom() UiError = {
    return UiError{
        kind: UiErrorKind.OutOfMemory
        line: 0
        message: "out of memory"
    }
}

pub fn new_form(
    title: str.StringView,
    width: i32,
    height: i32
) result[mut ref Form, UiError] = trust {
    val arena: mut ref mem.Bump = mem.new(1048576 as usize)
    if arena == none {
        return err oom()
    }

    val root: ref node.Node = node.new(arena, node.Kind.Form)
    if root == none {
        mem.free(arena)
        return err oom()
    }
    val mr: mut ref node.Node = root as mut ref node.Node
    mr.name = arena_str(arena, "form")
    mr.title = arena_str(arena, title)
    mr.width = width
    mr.height = height

    val f: mut ref Form = alloc_form()
    if f == none {
        mem.free(arena)
        return err oom()
    }
    f.arena = arena
    f.root = root
    f.cursor = root
    f.last_node = root
    f.last_field = none
    f.table = none
    f.title = mr.title
    f.name = mr.name
    f.width = width
    f.height = height
    f.theme = 0
    f.decorations = 0
    return ok f
}

pub fn new_from_ft(
    path: str.StringView,
    width: i32,
    height: i32
) result[mut ref Form, UiError] = trust {
    val arena: mut ref mem.Bump = mem.new(2097152 as usize)
    if arena == none {
        return err oom()
    }

    val file_opt = fs.read_all_heap(path)
    val file: mut ref u8 = none
    match file_opt {
        some data => {
            file = data
        }
        none => {
            mem.free(arena)
            return err UiError{
                kind: UiErrorKind.Io
                line: 0
                message: "cannot read template file"
            }
        }
    }
    val source: str.StringView = str.from_cstr(file)
    val parsed = ft_mod.parse(arena, source)
    @free(file as ref void)
    match parsed {
        err e => {
            mem.free(arena)
            return err UiError{
                kind: UiErrorKind.Template
                line: e.line
                message: e.message
            }
        }
        ok root => {
            val mr: ref node.Node = root as ref node.Node
            val f: mut ref Form = alloc_form()
            if f == none {
                mem.free(arena)
                return err oom()
            }
            f.arena = arena
            f.root = root
            f.cursor = root
            f.last_node = root
            f.last_field = none
            f.table = none
            f.title = mr.title
            f.name = mr.name
            f.theme = mr.theme
            f.decorations = mr.decorations
            f.width = width
            f.height = height
            if f.width <= 0 {
                f.width = mr.width
            }
            if f.height <= 0 {
                f.height = mr.height
            }
            if f.width <= 0 {
                f.width = 860
            }
            if f.height <= 0 {
                f.height = 720
            }
            return ok f
        }
    }
}

pub fn free(f: ref Form) void = trust {
    if f == none {
        return
    }
    val cur: mut ref Handler = f.handlers
    for {
        if cur == none {
            break
        }
        val h: ref Handler = cur as ref Handler
        if h.event != none && h.event != c"" {
            @free(h.event as ref void)
        }
        if h.name != none && h.name != c"" {
            @free(h.name as ref void)
        }
        cur = h.next
        @free(h as ref void)
    }
    if f.arena != none {
        mem.free(f.arena)
    }
    @free(f as ref void)
}

pub fn set_title(f: mut ref Form, title: str.StringView) void = trust {
    f.title = arena_str(f.arena, title)
    val r: mut ref node.Node = f.root as mut ref node.Node
    r.title = f.title
}

pub fn set_size(f: mut ref Form, width: i32, height: i32) void = {
    f.width = width
    f.height = height
}

pub fn set_theme(f: mut ref Form, theme: Theme) void = {
    f.theme = theme as i32
}

/// Requests client-drawn window decorations. Unsupported platforms keep the
/// native window frame.
pub fn set_decorations(f: mut ref Form, decorations: Decorations) void = {
    f.decorations = decorations as i32
}

pub fn name(f: mut ref Form, value: str.StringView) void = trust {
    f.name = arena_str(f.arena, value)
    val r: mut ref node.Node = f.root as mut ref node.Node
    r.name = f.name
}

fn add(f: mut ref Form, n: ref node.Node) void = {
    if n == none || f.cursor == none {
        return
    }
    node.append(f.cursor, n)
    f.last_node = n
}

pub fn header(f: mut ref Form, title: str.StringView, subtitle: str.StringView) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Header)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.title = arena_str(f.arena, title)
    mn.subtitle = arena_str(f.arena, subtitle)
    add(f, n)
    f.cursor = n
}

pub fn section(f: mut ref Form, title: str.StringView, desc: str.StringView) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Section)
    if n == none {
        return
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.title = arena_str(f.arena, title)
    mn.subtitle = arena_str(f.arena, desc)
    add(f, n)
    f.cursor = n
}

pub fn row(f: mut ref Form) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Row)
    add(f, n)
    if n != none {
        f.cursor = n
    }
}

pub fn actions(f: mut ref Form) void = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Actions)
    add(f, n)
    if n != none {
        f.cursor = n
    }
}

pub fn end(f: mut ref Form) void = {
    if f.cursor == none {
        return
    }
    if f.cursor.parent != none {
        f.cursor = f.cursor.parent
    }
}

fn field_base(
    f: mut ref Form,
    kind: node.FieldKind,
    field_name: str.StringView,
    label: str.StringView
) ref node.Node = trust {
    val n: ref node.Node = node.new(f.arena, node.Kind.Field)
    if n == none {
        return none
    }
    val mn: mut ref node.Node = n as mut ref node.Node
    mn.field = kind
    mn.name = arena_str(f.arena, field_name)
    mn.label = arena_str(f.arena, label)
    add(f, n)
    f.last_field = n
    return n
}

pub fn text_input(f: mut ref Form, field_name: str.StringView, label: str.StringView) void = trust {
    val n = field_base(f, node.FieldKind.Text, field_name, label)
    if n != none {
        f.last_field = n
    }
}

pub fn email_input(
    f: mut ref Form,
    field_name: str.StringView,
    label: str.StringView
) void = trust {
