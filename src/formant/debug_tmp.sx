val mem = use("mem.sx")
val stdio = use("std/stdio")
val str = use("std/string")
val ft = use("ft.sx")
pub fn main() i32 = trust {
    val b = mem.new(65536 as usize)
    val src: str.StringView = \\<form name="contact" title="Contact" width="720" height="600" theme="linux">
\\  <section title="Details">
\\    <row>
\\      <field name="first" label="First name" required="true" />
\\      <field name="email" type="email" label="Email" />
\\    </row>
\\    <select name="country" label="Country">
\\      <option value="us">United States</option>
\\      <option value="ca">Canada</option>
\\    </select>
\\  </section>
\\  <actions>
\\    <button name="save" label="Save" variant="primary" submit="true" />
\\  </actions>
\\</form>
    val parsed = ft.parse(b, src)
    match parsed {
        ok root => {
            stdio.puts("A")
            assert @strcmp(root.name, c"contact") == 0
            stdio.puts("B")
            assert root.width == 720
            assert root.height == 600
            assert root.first != none
            stdio.puts("C")
            assert @strcmp(root.first.title, c"Details") == 0
            stdio.puts("D")
        }
        err e => {
            stdio.print("err {d}: {s}\n", {e.line, e.message})
            assert false
        }
    }
    mem.free(b)
    return 0
}
